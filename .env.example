# Copia este ejemplo a .env; configura secretos solo en tu equipo o en Render.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
# Alternativas:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-hydrogen
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-astra
# APP_PASSWORD_HASH= (lo genera node scripts/create-access.mjs)
# APP_ORIGIN=https://tu-servicio.onrender.com
# APP_PYTHON=/ruta/python
# PORT=4317
